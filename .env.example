# Local SQLite database. On Vercel, replace this with a Neon or Vercel Postgres URL
# and change prisma/schema.prisma datasource provider from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Generate a long random string for production. Used to sign session cookies.
AUTH_SECRET="replace-with-a-long-random-string"

# Public site URL. Use your Vercel domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# demo = simulated card payments with real commission math (no Stripe charge)
# stripe = live Stripe Connect destination charges
PAYMENTS_MODE="demo"

# Stripe Connect (Express). Required for live tutor payouts.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Zoom Server-to-Server OAuth. Meetings are stored without a link until these are set.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Optional email via Resend. In-app notifications work without this.
RESEND_API_KEY=""
EMAIL_FROM="1% Better Tutoring <hello@onepercentbetter.com>"

# Protects /api/cron/reminders. Set the same value in Vercel.
CRON_SECRET=""

# Optional Google Calendar OAuth. .ics downloads work without this.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
