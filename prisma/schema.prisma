generator client {
  provider = "prisma-client-js"
}

// Production and Vercel use PostgreSQL (Neon or Vercel Postgres).
// Set DATABASE_URL to that connection string. Local SQLite is no longer used once this is set.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               String
  phone              String?
  timezone           String   @default("America/New_York")
  imageUrl           String?
  googleRefreshToken String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studentProfile   StudentProfile?
  tutorProfile     TutorProfile?
  parentProfile    ParentProfile?
  sentMessages         Message[]            @relation("SentMessages")
  receivedMessages     Message[]            @relation("ReceivedMessages")
  notifications        Notification[]
  documents            Document[]
  reviewsWritten       Review[]             @relation("ReviewsWritten")
  safetyReports        SafetyReport[]       @relation("ReportsFiled")
  pinnedConversations  PinnedConversation[]

  @@index([role])
}

model StudentProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradeLevel     String?
  school         String?
  goals          String  @default("")
  subjectsNeeded String  @default("")
  guardianEmail  String?
  isMinor        Boolean @default(false)
  referralCode   String  @unique
  referredByCode String?
  parentId       String?
  parent         ParentProfile? @relation(fields: [parentId], references: [id])

  bookings    Booking[]
  assignments Assignment[]
  requests    TutoringRequest[]
  homework    Homework[]
  progress    ProgressNote[]
}

model ParentProfile {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students  StudentProfile[]
}

model TutorProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                   String   @unique
  university             String
  major                  String
  degree                 String
  graduationYear         Int
  bio                    String
  experience             String
  education              String   @default("")
  achievements           String   @default("")
  certifications         String   @default("")
  testScores             String   @default("")
  subjects               String
  gradeLevels            String
  hourlyRateCents        Int
  introVideoUrl          String?
  status                 String   @default("PENDING")
  verified               Boolean  @default(false)
  active                 Boolean  @default(false)
  featured               Boolean  @default(false)
  availabilityNotes      String   @default("")
  adminNotes             String   @default("")
  moreInfoRequest        String   @default("")
  pendingChanges         String?
  stripeAccountId        String?
  stripeChargesEnabled   Boolean  @default(false)
  stripePayoutsEnabled   Boolean  @default(false)
  stripeDetailsSubmitted Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  availability AvailabilityRule[]
  blocks       AvailabilityBlock[]
  bookings     Booking[]
  assignments  Assignment[]
  requests     TutoringRequest[]
  homework     Homework[]
  reviews      Review[]
  progress     ProgressNote[]
  reports      SessionReport[]

  @@index([status, active])
  @@index([university])
}

model AvailabilityRule {
  id        String       @id @default(cuid())
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startMin  Int
  endMin    Int

  @@index([tutorId])
}

model AvailabilityBlock {
  id      String       @id @default(cuid())
  tutorId String
  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  date    String
  reason  String       @default("")

  @@index([tutorId, date])
}

model Booking {
  id                     String         @id @default(cuid())
  studentId              String
  student                StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorId                String
  tutor                  TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  type                   String
  status                 String
  startsAt               DateTime
  endsAt                 DateTime
  timezone               String
  durationMin            Int
  priceCents             Int            @default(0)
  tutorShareCents        Int            @default(0)
  platformShareCents     Int            @default(0)
  commissionPercent      Int            @default(0)
  zoomJoinUrl            String?
  zoomStartUrl           String?
  zoomMeetingId          String?
  notes                  String         @default("")
  cancelReason           String?
  stripePaymentIntentId  String?
  stripeCheckoutSessionId String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  transaction Transaction?
  report      SessionReport?
  review      Review?

  @@index([tutorId, startsAt])
  @@index([studentId, startsAt])
  @@index([status])
  @@index([type])
}

model Assignment {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorId      String
  tutor        TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  status       String         @default("ACTIVE")
  assignedById String?
  notes        String         @default("")
  createdAt    DateTime       @default(now())
  endedAt      DateTime?

  @@unique([studentId, tutorId])
  @@index([status])
}

model TutoringRequest {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorId    String
  tutor      TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  message    String
  goals      String         @default("")
  status     String         @default("PENDING")
  adminNote  String         @default("")
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?

  @@index([status])
}

model Message {
  id             String    @id @default(cuid())
  senderId       String
  sender         User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body           String
  attachmentName String?
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, readAt])
}

model PinnedConversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otherUserId String
  createdAt   DateTime @default(now())

  @@unique([userId, otherUserId])
  @@index([userId])
}

model Homework {
  id             String         @id @default(cuid())
  tutorId        String
  tutor          TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  description    String
  subject        String         @default("")
  dueAt          DateTime?
  materialText   String         @default("")
  status         String         @default("ASSIGNED")
  submissionText String         @default("")
  feedback       String         @default("")
  grade          String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([studentId, status])
  @@index([tutorId])
}

model SessionReport {
  id              String       @id @default(cuid())
  bookingId       String       @unique
  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutorId         String
  tutor           TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  topics          String
  performance     String
  improvements    String
  recommendations String
  createdAt       DateTime     @default(now())
}

model ProgressNote {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorId     String
  tutor       TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  goal        String
  note        String
  metricLabel String?
  metricValue String?
  createdAt   DateTime       @default(now())

  @@index([studentId])
}

model Review {
  id        String       @id @default(cuid())
  bookingId String?      @unique
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  tutorId   String
  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("ReviewsWritten", fields: [authorId], references: [id])
  rating    Int
  comment   String
  verified  Boolean      @default(false)
  published Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([tutorId, published])
}

model Transaction {
  id                    String   @id @default(cuid())
  bookingId             String   @unique
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents           Int
  tutorShareCents       Int
  platformShareCents    Int
  stripeFeeCents        Int      @default(0)
  netPlatformCents      Int      @default(0)
  currency              String   @default("usd")
  status                String
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String?
  stripeBalanceTxnId    String?
  failureReason         String?
  refundedCents         Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  fileName  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId, kind])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
  handled   Boolean  @default(false)
}

model SafetyReport {
  id            String   @id @default(cuid())
  reporterId    String
  reporter      User     @relation("ReportsFiled", fields: [reporterId], references: [id])
  subjectUserId String?
  reason        String
  details       String
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())

  @@index([status])
}

model PlatformSettings {
  id                  String @id @default("default")
  commissionPercent   Int    @default(30)
  minHourlyRateCents  Int    @default(2500)
  maxHourlyRateCents  Int    @default(30000)
  feePolicy           String @default("PLATFORM_ABSORBS")
  consultationMinutes Int    @default(15)
  sessionMinutes      Int    @default(60)
  cancelWindowHours   Int    @default(24)
}

model Referral {
  id             String   @id @default(cuid())
  code           String
  referrerUserId String
  referredUserId String?
  status         String   @default("SIGNED_UP")
  createdAt      DateTime @default(now())

  @@index([code])
}
